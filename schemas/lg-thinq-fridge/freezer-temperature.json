{
  "id": "freezerTemperature",
  "version": 1,
  "status": "proposed",
  "name": "Freezer Temperature",
  "attributes": {
    "temperatureC": {
      "schema": {
        "type": "object",
        "properties": {
          "value": { "type": "integer", "minimum": -21, "maximum": -13 },
          "unit": { "type": "string", "enum": ["C"], "default": "C" }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "setter": "setTemperatureC"
    }
  },
  "commands": {
    "setTemperatureC": {
      "arguments": [
        {
          "name": "temperature",
          "schema": { "type": "integer", "minimum": -21, "maximum": -13 },
          "optional": false
        }
      ]
    }
  }
}
