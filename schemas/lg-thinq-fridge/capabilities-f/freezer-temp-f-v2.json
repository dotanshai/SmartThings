{
  "id": "freezerTemperatureF",
  "version": 1,
  "status": "proposed",
  "name": "Freezer Temperature F",
  "attributes": {
    "temperatureF": {
      "schema": {
        "type": "object",
        "properties": {
          "value": { "type": "number", "minimum": -6, "maximum": 8, "multipleOf": 0.1 },
          "unit": { "type": "string", "enum": ["F"], "default": "F" }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "setter": "setTemperatureF"
    }
  },
  "commands": {
    "setTemperatureF": {
      "name": "setTemperatureF",
      "arguments": [
        { "name": "temperature", "optional": false, "schema": { "type": "number", "minimum": -6, "maximum": 8, "multipleOf": 0.1 } }
      ]
    }
  }
}
