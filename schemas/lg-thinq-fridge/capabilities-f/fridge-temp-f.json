{
  "id": "fridgeTempF",
  "version": 1,
  "status": "proposed",
  "name": "Fridge Temperature F",
  "attributes": {
    "temperatureF": {
      "schema": {
        "type": "object",
        "properties": {
          "value": { "type": "integer", "minimum": 33, "maximum": 46 },
          "unit": { "type": "string", "enum": ["F"], "default": "F" }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "setter": "setTemperatureF"
    }
  },
  "commands": {
    "setTemperatureF": {
      "name": "setTemperatureF",
      "arguments": [
        { "name": "temperature", "optional": false, "schema": { "type": "integer", "minimum": 33, "maximum": 46 } }
      ]
    }
  }
}
