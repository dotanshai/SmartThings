{
  "id": "fridgeTempC",
  "version": 1,
  "status": "proposed",
  "name": "Fridge Temperature C",
  "attributes": {
    "temperatureC": {
      "schema": {
        "type": "object",
        "properties": {
          "value": { "type": "integer", "minimum": 1, "maximum": 8 },
          "unit": { "type": "string", "enum": ["C"], "default": "C" }
        },
        "additionalProperties": false,
        "required": ["value"]
      },
      "setter": "setTemperatureC"
    }
  },
  "commands": {
    "setTemperatureC": {
      "name": "setTemperatureC",
      "arguments": [
        { "name": "temperature", "optional": false, "schema": { "type": "integer", "minimum": 1, "maximum": 8 } }
      ]
    }
  }
}
