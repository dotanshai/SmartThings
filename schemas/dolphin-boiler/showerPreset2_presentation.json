        "unit": "temperature.unit"
      }
    },
    {
      "label": "Shower Preset 2",
      "displayType": "toggleSwitch",
      "toggleSwitch": {
        "command": {
          "name": "setSwitch",
          "on": "on",
          "off": "off",
          "argumentType": "string"
        },
        "state": {
          "value": "switch.value",
          "on": "on",
          "off": "off",
          "valueType": "string"
        }
      }
    }
  ]
