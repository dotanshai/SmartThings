{
  "name": "LG ThinQ Laundry v12",
  "components": [
    {
      "id": "main",
      "capabilities": [
        { "id": "switch" },
        { "id": "refresh" },
        { "id": "vehiclepatch55148.washerStatus" },
        { "id": "vehiclepatch55148.laundryErrorV2" },
        { "id": "vehiclepatch55148.cycleTimers" },
        { "id": "vehiclepatch55148.remoteReady" },
        { "id": "vehiclepatch55148.laundryCycles" },
        { "id": "healthCheck" }
      ],
      "categories": [
        { "name": "Washer" }
      ]
    }
  ],
  "metadata": {
    "deviceType": "Washer"
  },
  "view": {
    "dashboard": {
      "states": [
        { "capability": "switch", "composite": true },
        {
          "capability": "vehiclepatch55148.washerStatus",
          "composite": true,
          "values": [
            { "label": " {{machineStateDisplay.value}}" }
          ]
        }
      ],
      "actions": [
        { "capability": "switch" }
      ]
    },
    "detailView": [
      { "capability": "switch" },
      {
        "capability": "refresh",
        "displayType": "pushButton",
        "pushButton": { "command": "refresh" }
      },
      { "capability": "vehiclepatch55148.washerStatus" },
      { "capability": "vehiclepatch55148.laundryErrorV2" },
      {
        "capability": "vehiclepatch55148.cycleTimers",
        "visibleCondition": {
          "capability": "vehiclepatch55148.cycleTimers",
          "version": 1,
          "component": "main",
          "value": "timersVisible.value",
          "operator": "EQUALS",
          "operand": "show",
          "hideOnUnmatch": true
        }
      },
      { "capability": "vehiclepatch55148.remoteReady" },
      { "capability": "vehiclepatch55148.laundryCycles" },
      { "capability": "healthCheck" }
    ],
    "automation": {
      "conditions": [
        { "capability": "switch" },
        { "capability": "vehiclepatch55148.washerStatus" },
        { "capability": "vehiclepatch55148.laundryErrorV2" },
        { "capability": "vehiclepatch55148.cycleTimers" },
        { "capability": "vehiclepatch55148.remoteReady" },
        { "capability": "vehiclepatch55148.laundryCycles" },
        { "capability": "healthCheck" }
      ],
      "actions": [
        { "capability": "switch" },
        { "capability": "healthCheck" }
      ]
    }
  }
}
